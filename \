<div class="container py-5 px-sm-5">
  @if(user !== null) {

  <div class="row justify-content-between align-items-center ">
    <div class="col-4 bg-primary">
      <div class="">
        <label for="exampleColorInput" class="form-label">Cor principal</label>
        <input type="color" class="form-control form-control-color" id="exampleColorInput"
          title="Cor principal" [(ngModel)]="foregroundColor">
      </div>
      <div class="">
        <label for="exampleColorInput" class="form-label">Cor de fundo</label>
        <input type="color" class="form-control form-control-color" id="exampleColorInput"
          title="Cor de fundo" [(ngModel)]="backgroundColor">
      </div>
      <div class=" d-flex">
        <p class="me-1">Margem:</p>
        <div class="btn-group" role="group" aria-label="Basic radio toggle button group">
          <input type="radio" class="btn-check" name="btnradio" id="btnradio1" autocomplete="off" checked>
          <label class="btn btn-outline-primary" for="btnradio1" (click)="qrcodeMargin = 1">1</label>

          <input type="radio" class="btn-check" name="btnradio" id="btnradio2" autocomplete="off">
          <label class="btn btn-outline-primary" for="btnradio2" (click)="qrcodeMargin = 2">2</label>

          <input type="radio" class="btn-check" name="btnradio" id="btnradio4" autocomplete="off">
          <label class="btn btn-outline-primary" for="btnradio4" (click)="qrcodeMargin = 4">4</label>

          <input type="radio" class="btn-check" name="btnradio" id="btnradio8" autocomplete="off">
          <label class="btn btn-outline-primary" for="btnradio8" (click)="qrcodeMargin = 8">8</label>
        </div>
      </div>
    </div>
    <div class="col-8  justify-content-center">
      <qrcode class="col-auto"
        elementType="canvas"
        #qrCodeElement
        [qrdata]="user.establishmentName"
        [width]="256"
        [colorDark]="foregroundColor"
        [colorLight]="backgroundColor"
        [margin]="qrcodeMargin"
        [errorCorrectionLevel]="'M'"></qrcode>

      <div>
        <button class="btn btn-lg btn-primary col-auto" (click)="saveAsImage()">
          Download QR Code Image
        </button>
      </div>
    </div>
  </div>
  } @else {
  <p>Erro ao carregar página!</p>
  }
</div>
